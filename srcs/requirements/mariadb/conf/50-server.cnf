# this is only for the mysqld standalone daemon (this is what listens for connections)
[mysqld]

# Listens in all nework interfaces (0.0.0.0) so it can communicate outside the container
# in port 3306 (standard)
bind-address = 0.0.0.0
port = 3306

# socket route (for local communications)
socket = /var/run/mysqld/mysqld.sock

# where the volume is stored
datadir = /var/lib/mysql

# where logs are saved (for debugging)
log-error = /var/log/mysql/error.log

# file to monitor the daemon
pid-file = /var/run/mysqld/mysqld.pid

#
# * Basic Settings
#

#user                    = mysql
basedir                 = /usr
#datadir                 = /var/lib/mysql
#tmpdir                  = /tmp
#
# * Logging and Replication
#

# The following can be used as easy to replay backup logs or for replication.
# note: if you are setting up a replication slave, see README.Debian about
#       other settings you may need to change.
#server-id              = 1
#log_bin                = /var/log/mysql/mysql-bin.log
expire_logs_days        = 10
#max_binlog_size        = 100M

#
# * Character sets
#

# MySQL/MariaDB default is Latin1, but in Debian we rather default to the full
# utf8 4-byte character set. See also client.cnf
character-set-server  = utf8mb4
collation-server      = utf8mb4_general_ci
